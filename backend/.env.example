# ─── LLM / AI ────────────────────────────────────────────────────────────────
# Groq API key for Llama-powered root-cause analysis.
# Leave blank to run in heuristic-only mode (no LLM calls).
GROQ_API_KEY=your_groq_api_key_here

# ─── Vector Store (Qdrant) ───────────────────────────────────────────────────
# Leave QDRANT_URL empty to use local file-based Qdrant (good for single host).
# Set to a remote Qdrant server URL for production / multi-container setups.
QDRANT_URL=
QDRANT_API_KEY=

# ─── Database ────────────────────────────────────────────────────────────────
# Absolute path where the SQLite database file will be stored.
# Defaults to <project-root>/flaky_test_detector.db when unset.
# In Docker, set to /data/flaky_test_detector.db (matches the volume mount).
DB_PATH=/data/flaky_test_detector.db

# ─── Security ────────────────────────────────────────────────────────────────
# API key protecting the /api/v1/test-runs/ingest endpoint.
# Set to a random secret string (e.g. `openssl rand -hex 32`).
# Leave blank to disable authentication (development only).
API_KEY=your_ingestion_api_key_here

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Default: http://localhost:5173,http://localhost:8080
ALLOWED_ORIGINS=https://your-dashboard.example.com

